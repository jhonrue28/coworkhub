    {
      "name": "Escenarios",
      "item": [
        {
          "name": "1. Reservar sala libre con 2 servicios → 201 con costo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salaId\": 1,\n  \"miembroId\": {{miembroPruebasId}},\n  \"inicio\": \"{{dia}}T09:00:00\",\n  \"fin\": \"{{dia}}T10:00:00\",\n  \"asistentes\": 4,\n  \"servicios\": [\n    { \"servicioId\": 1, \"cantidad\": 2 },\n    { \"servicioId\": 2, \"cantidad\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pad = n => String(n).padStart(2, '0');",
                  "const fmt = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':00';",
                  "const enHoras = h => { const d = new Date(Date.now() + h * 3600000); d.setSeconds(0, 0); return d; };",
                  "// 30 min a h horas de ahora; si cruza la medianoche, pasa a las 00:00 (agrega menos de 30 min)",
                  "const turno = h => { let s = enHoras(h), e = new Date(s.getTime() + 1800000);",
                  "  if (e.getDate() !== s.getDate()) { s = new Date(e); s.setHours(0, 0, 0, 0); e = new Date(s.getTime() + 1800000); }",
                  "  return [s, e]; };",
                  "const d = new Date(); d.setDate(d.getDate() + 10);",
                  "pm.collectionVariables.set('dia', fmt(d).slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Costo: sala 50.000 + servicios 65.000 = 115.000', () => { const r = pm.response.json(); pm.expect(r.costoSala).to.eql(50000); pm.expect(r.costoServicios).to.eql(65000); pm.expect(r.costoTotal).to.eql(115000); pm.expect(r.estado).to.eql('PENDING'); });"
                ]
              }
            }
          ]
        },
