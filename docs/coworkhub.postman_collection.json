          "name": "13. Dos solicitudes simultáneas → una 201 y otra 409",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
