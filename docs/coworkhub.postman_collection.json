                "health"
              ]
            },
            "description": "Postman ejecuta las solicitudes en orden, así que el script de Tests envía las dos reservas en paralelo con pm.sendRequest."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setDate(d.getDate() + 12);",
                  "const dia = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
                  "const body = { salaId: 5, miembroId: Number(pm.collectionVariables.get('miembroPruebasId')), inicio: dia + 'T10:00:00', fin: dia + 'T11:00:00', asistentes: 2 };",
                  "const send = () => new Promise((resolve, reject) => pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/reservas', method: 'POST',",
                  "  header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + pm.collectionVariables.get('tokenAdmin') },",
                  "  body: { mode: 'raw', raw: JSON.stringify(body) }",
                  "}, (err, res) => err ? reject(err) : resolve(res)));",
                  "Promise.all([send(), send()]).then(responses => {",
                  "  const codes = responses.map(r => r.code).sort();",
                  "  pm.test('Una 201 y otra 409 (' + codes.join(', ') + ')', () => pm.expect(codes).to.eql([201, 409]));",
                  "  const conflict = responses.find(r => r.code === 409);",
                  "  pm.test('La rechazada es RN-01', () => pm.expect(conflict && conflict.json().codigo).to.eql('RN-01'));",
                  "});"
                ]
              }
            }
          ]
