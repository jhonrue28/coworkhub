        {
          "name": "5a. Crear reserva a 30 h",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salaId\": {{salaPruebasId}},\n  \"miembroId\": {{miembroPruebasId}},\n  \"inicio\": \"{{inicio}}\",\n  \"fin\": \"{{fin}}\",\n  \"asistentes\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Usa la sala de la sede de pruebas (00:00-23:59), así el escenario no depende de la hora en que se corre."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pad = n => String(n).padStart(2, '0');",
                  "const fmt = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':00';",
                  "const enHoras = h => { const d = new Date(Date.now() + h * 3600000); d.setSeconds(0, 0); return d; };",
                  "// 30 min a h horas de ahora; si cruza la medianoche, pasa a las 00:00 (agrega menos de 30 min)",
                  "const turno = h => { let s = enHoras(h), e = new Date(s.getTime() + 1800000);",
                  "  if (e.getDate() !== s.getDate()) { s = new Date(e); s.setHours(0, 0, 0, 0); e = new Date(s.getTime() + 1800000); }",
                  "  return [s, e]; };",
                  "const [s, e] = turno(30);",
                  "pm.variables.set('inicio', fmt(s));",
                  "pm.variables.set('fin', fmt(e));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('reserva5', pm.response.json().id);",
                  "pm.collectionVariables.set('reserva5CostoSala', pm.response.json().costoSala);"
                ]
              }
            }
          ]
        },
        {
          "name": "5b. Cancelar con 30 h → 200, cargo 0",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/{{reserva5}}/cancelar",
              "host": [
